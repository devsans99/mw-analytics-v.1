# Copy to .env and edit. Never commit .env.
FLASK_APP=run.py

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Secret CMS location -> /<ADMIN_URL_PREFIX>/login. Use a long random value per deployment.
ADMIN_URL_PREFIX=cms-k7x2q9mf4a

SITE_NAME=MWA

# PostgreSQL (used by Docker compose files; DATABASE_URL is built from these)
POSTGRES_DB=mwa
POSTGRES_USER=mwa
POSTGRES_PASSWORD=change-me

# Production only (compose.yaml)
DOMAIN=example.com
